# Copy to .env.local and fill in. Never commit real values (CLAUDE.md: Secrets).
# Production values live in Vercel.

# Supabase (v2 project only, never the v1 SoMS/PMS databases)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# AI assistant (Phase 5)
ANTHROPIC_API_KEY=

# Organisation for local dev on plain http://localhost:3000. Not needed when
# you open http://<slug>.localhost:3000, and not used in production, where the
# subdomain (<slug>.assetnxg.app) picks the organisation.
DEV_ORG_SLUG=
